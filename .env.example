# Budapest Public Transport Delay Monitor - example environment config.
# Copy to `.env` and adjust as needed. All data sources are free.

# --- BKK GTFS-Realtime ---
# Requires a FREE API key (no payment). Register at https://opendata.bkk.hu/
# to obtain one. If left empty, the app runs in MOCK mode so nothing breaks.
BKK_API_KEY=83a9aea0-1cee-41bb-b3a1-4cd19967d3ed

# Static GTFS feed (public, free)
GTFS_STATIC_URL=https://bkk.hu/gtfs/budapest_gtfs.zip

# GTFS-Realtime endpoints (append ?key=... at runtime)
GTFS_RT_TRIP_UPDATES_URL=https://go.bkk.hu/api/query/v1/ws/gtfs-rt/full/TripUpdates.pb
GTFS_RT_VEHICLE_POSITIONS_URL=https://go.bkk.hu/api/query/v1/ws/gtfs-rt/full/VehiclePositions.pb

# Open-Meteo weather API (no key required)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Budapest default coordinates (fallback when geolocation is unavailable) ---
CITY_LAT=47.4979
CITY_LON=19.0402

# --- Polling / freshness ---
# How often the background poller fetches a GTFS-RT snapshot (seconds).
POLL_INTERVAL_SECONDS=30
# A snapshot older than this many seconds is treated as stale (data status -> mock).
STALENESS_THRESHOLD_SECONDS=60
# Timeout for all outbound HTTP calls (seconds).
HTTP_TIMEOUT_SECONDS=10

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
