# Base URL the API client calls. Defaults to "/api", which the Vite dev server
# proxies to the backend. Set to an absolute origin to talk to a backend on a
# different host (e.g. https://api.example.com/api).
VITE_API_BASE_URL=/api

# Origin the dev-server /api proxy forwards to. Defaults to http://localhost:8000
# (the FastAPI backend from backend/config.py).
VITE_BACKEND_ORIGIN=http://localhost:8000
